+
+    runner = OracleRunner(failing, rejected_cache_max=4)
+    case = make_case()
+    assert not runner.supports(case)
+    assert not runner.supports(case)
+    assert len(calls) == 1
+    assert runner.stats.rejected_cache_hits == 1
