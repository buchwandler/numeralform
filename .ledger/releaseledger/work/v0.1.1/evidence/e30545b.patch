+
+
+def locale_data(
+    locale: str,
+    digits: tuple[str, ...],
+    *,
+    compound: str = " ",
+    negative: str = "minus",
+    ordinal_suffix: str = "th",
+    ordinal_prefix: str = "",
+) -> RendererData:
+    return RendererData(
+        digits=digits,
+        scales=_DEFAULT_SCALES[locale],
+        decimal=_DECIMALS.get(locale, "point"),
+        negative=negative,
